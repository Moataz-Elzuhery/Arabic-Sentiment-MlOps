FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 BENTOML_DO_NOT_TRACK=True
COPY requirements-bento.txt .
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r requirements-bento.txt
COPY src ./src
COPY service.py .
ENV MODEL_DIR=/app/models/v1
EXPOSE 3000
CMD ["bentoml", "serve", "service:SentimentService", "--host", "0.0.0.0", "--port", "3000"]
