# Copy this file to .env:   Copy-Item .env.example .env
# Docker Compose reads .env automatically. .env is git-ignored; .env.example is committed.
# A variable set in the shell ($env:NAME=...) overrides the value in this file.

# --- Model folders (paths INSIDE the containers; ./models is mounted at /app/models) ---
API_MODEL_DIR=/app/models/v1
STABLE_MODEL_DIR=/app/models/v1
CANARY_MODEL_DIR=/app/models/v2

# --- BentoML adaptive batching ---
MAX_BATCH_SIZE=32
# Max time a request may wait in the batching queue (ms). Too small => HTTP 503.
MAX_LATENCY_MS=2000

# --- Canary release (nginx router) ---
# Share of traffic sent to the canary, 1-100 (nginx rejects 0%).
CANARY_PCT=5
# 1 = canary receives CANARY_PCT of traffic, 0 = rollback (all traffic to the stable model).
CANARY_ENABLED=1

# --- Not read by Compose: export them in your shell if you need them ---
# HF_TOKEN=                     Hugging Face token (removes the "unauthenticated requests" warning)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
