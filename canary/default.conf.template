# Weighted traffic split between the stable model (v1) and the canary (v2).
# CANARY_PCT (1-100) and CANARY_ENABLED (1 or 0) are substituted by the nginx image at start
# (envsubst). nginx rejects "0%", so rollback uses CANARY_ENABLED=0 instead of CANARY_PCT=0.
upstream v1 { server api_v1:8000; }
upstream v2 { server api_v2:8000; }

# $request_id is random per request, so each request is assigned independently.
split_clients "${request_id}" $split {
    ${CANARY_PCT}%   v2;
    *                v1;
}

# Kill switch: CANARY_ENABLED=0 sends everything to v1.
map "${CANARY_ENABLED}" $backend {
    "0"      v1;
    default  $split;
}

server {
    listen 80;

    location = /router-health {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        add_header X-Backend $backend always;
    }
}
